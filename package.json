{
  "name": "kitsu-web",
  "version": "4.0.0",
  "files": [
    "dist"
  ],
  "module": "./dist/kitsu-v4.es.js",
  "exports": {
    ".": {
      "import": "./dist/kitsu-v4.es.js"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie <= 11",
    "not op_mini all"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "run-p dev:*",
    "dev:vite": "BUILD_TARGET=client vite --host --strictPort --port 5173",
    "dev:storybook": "BUILD_TARGET=client storybook dev -p 6006",
    "typecheck": "BUILD_TARGET=client tsc --noEmit -p tsconfig.typecheck.json",
    "build": "run-p build:*",
    "build:client": "BUILD_TARGET=client vite build",
    "build:library": "BUILD_TARGET=library vite build",
    "build:storybook": "BUILD_TARGET=client storybook build --output-dir ./dist/client/docs/ui/",
    "test": "run-p test:*",
    "test:unit": "BUILD_TARGET=client vitest run --coverage",
    "test:unit:watch": "BUILD_TARGET=client vitest watch",
    "test:e2e": "cypress",
    "codegen": "run-p codegen:*",
    "codegen:intl": "tsx ./bin/extract-intl.mts",
    "codegen:css-globals": "tsx ./bin/extract-css-globals.mts",
    "codegen:graphql-schema": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@hookform/resolvers": "^5.4.0",
    "@nanoauth/base": "^0.3.0",
    "@nanoauth/myanimelist": "^0.2.3",
    "@popperjs/core": "^2.11.8",
    "@radix-ui/react-accessible-icon": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.17",
    "@react-hookz/web": "^25.2.0",
    "@sentry/react": "^10.58.0",
    "@urql/core": "^6.0.2",
    "@urql/devtools": "^2.0.3",
    "@urql/exchange-auth": "^3.0.0",
    "@urql/exchange-graphcache": "^9.0.1",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "blurhash": "^2.0.5",
    "date-fns": "^4.4.0",
    "gql.tada": "^1.11.2",
    "graphql": "^16.14.2",
    "graphql-scalars": "^1.25.0",
    "lodash-es": "^4.18.1",
    "preferred-locale": "^2.0.2",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-blurhash": "^0.3.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-icons": "^5.6.0",
    "react-intl": "^10.1.13",
    "react-popper": "^2.3.0",
    "react-router": "^8.0.1",
    "react-use": "^17.6.1",
    "tiny-invariant": "^1.3.3",
    "urql": "^5.0.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@csstools/postcss-extract": "^5.0.0",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^9.39.4",
    "@etchteam/storybook-addon-status": "^8.1.0",
    "@formatjs/cli-lib": "^8.7.10",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/introspection": "^6.0.1",
    "@graphql-codegen/urql-introspection": "^4.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@rollup/pluginutils": "^5.4.0",
    "@small-tech/vite-plugin-sri": "github:small-tech/vite-plugin-sri#main",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.4.6",
