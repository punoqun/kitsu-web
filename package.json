    "prettier": "^3.8.4",
    "rollup-plugin-formatjs": "^3.0.0",
    "sharp": "^0.35.1",
    "storybook": "^10.4.6",
    "storybook-addon-rtl": "^3.0.2",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-use-logical": "^2.1.3",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
